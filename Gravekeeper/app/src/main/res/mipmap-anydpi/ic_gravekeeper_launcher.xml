<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Explicit app-identity resource; avoids reusing the pre-Gravekeeper launcher ID. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/icon_background" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/ic_launcher_art" />
    </item>
</layer-list>
